#!/usr/bin/env bash
# ============================================================
# 主题：Arch —— 外网
# ============================================================
# 只写与 defaults.env 不同的键。
# 自动识别依据：/etc/os-release 的 ID=arch

PROFILE_NAME="Arch 外网"

# 外网的项目与 SionTiles 都在坚果云同步目录内
PROJECTS_ROOT="/home/song/NutstoreFiles/projects"

MICROMAMBA_BIN="/home/song/micromamba/bin/micromamba"
MAMBA_ROOT_PREFIX="/home/song/micromamba"

# 有桌面环境，启动后自动开浏览器
OPEN_BROWSER=true

PKG_HINT_WHIPTAIL="sudo pacman -S libnewt"
