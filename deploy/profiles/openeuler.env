#!/usr/bin/env bash
# ============================================================
# 主题：openEuler 24.03 LTS-SP4 —— 内网服务器
# ============================================================
# 只写与 defaults.env 不同的键。
# 自动识别依据：/etc/os-release 的 ID=openEuler

PROFILE_NAME="openEuler 24.03 内网服务器"

# 项目在本机用户目录；数据仍走坚果云挂载的 /home/song/NutstoreFiles
PROJECTS_ROOT="/home/songwp/projects"

MICROMAMBA_BIN="/home/songwp/bin/micromamba"
MAMBA_ROOT_PREFIX="/home/songwp/micromamba"

# 服务器无桌面环境，不自动开浏览器（访问地址见启动横幅）
OPEN_BROWSER=false

PKG_HINT_WHIPTAIL="sudo dnf install newt"
