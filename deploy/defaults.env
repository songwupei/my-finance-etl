#!/usr/bin/env bash
# ============================================================
# defaults.env — 部署配置：与环境无关的默认值
# ============================================================
# 这里不要写任何因机器而异的内容（绝对路径、端口占用、是否开浏览器）。
# 那些属于 deploy/profiles/<主题>.env，见 deploy/README.md。
#
# 加载顺序：defaults.env → profiles/<PROFILE>.env → local.env
# 每个键都可以被后面的层覆盖。
#
# 本文件一律用 `:=` 赋值：不覆盖调用者已传入的环境变量，
# 因此 `VIZRO_PORT=5002 bash start.sh` 这类临时覆盖依然有效。
# （profiles/ 与 local.env 用普通赋值，它们才是设计上的覆盖层。）

# ---- 标识（仅用于日志与菜单显示）----
PROFILE_NAME="${PROFILE_NAME:=未命名环境}"

# ---- 项目根（必填，必须由 profile 提供）----
# 外网：/home/song/NutstoreFiles/projects
# 内网：/home/songwp/projects
PROJECTS_ROOT="${PROJECTS_ROOT:-}"

# ---- Python 运行时 ----
# micromamba 可执行文件；留空则从 PATH 探测。
MICROMAMBA_BIN="${MICROMAMBA_BIN:-}"
# micromamba 根前缀，两台机器都是 $HOME/micromamba，一般无需设置。
MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-}"
# conda / micromamba 环境名。
# 这里用 `-` 而非 `:=`：未设置时取 myetl，显式设为空串则沿用调用者
# 当前激活的环境（旧行为，适合本地手动运行；服务器/cron 建议
# 显式指定，避免非激活 shell 掉进 base）。
CONDA_ENV="${CONDA_ENV-myetl}"
# 完全接管启动前缀（非 micromamba 场景，如 venv）。
# 例：RUNTIME_CMD="/opt/venv/bin/python"
RUNTIME_CMD="${RUNTIME_CMD:-}"

# ---- 监听地址与端口 ----
BIND_HOST="${BIND_HOST:=0.0.0.0}"
# 打印给用户访问的地址主机名。服务器可改成内网 IP 或域名。
PUBLIC_HOST="${PUBLIC_HOST:=localhost}"
SIONTILES_PORT="${SIONTILES_PORT:=8765}"
SHINY_PORT="${SHINY_PORT:=8000}"
VIZRO_PORT="${VIZRO_PORT:=5001}"

# ---- 路径（留空则按 PROJECTS_ROOT 派生）----
SIONTILES_DIR="${SIONTILES_DIR:-}"
SIONTILES_ENTRY="${SIONTILES_ENTRY:=server.py}"
LOG_DIR="${LOG_DIR:-}"

# ---- 行为开关 ----
# 无桌面环境的服务器设为 false，否则 xdg-open 每次都失败。
OPEN_BROWSER="${OPEN_BROWSER:=true}"
BROWSER_CMD="${BROWSER_CMD:=xdg-open}"
# 端口清理工具：auto / lsof / fuser。
KILL_TOOL="${KILL_TOOL:=auto}"
# 该环境若未部署 SionTiles 可设 false。
ENABLE_SIONTILES="${ENABLE_SIONTILES:=true}"
# 缺依赖时提示的安装命令（各发行版包名不同）。
PKG_HINT_WHIPTAIL="${PKG_HINT_WHIPTAIL:=sudo apt install whiptail}"

# ---- LaTeX（日报 PDF）----
# TinyTeX 安装目录。默认 $HOME/.TinyTeX，与 quarto 的默认探测位置一致；
# 若装在别处（例如以 root 安装落在 /root/.TinyTeX，或装在别的用户名下），
# 在 deploy/local.env 里覆盖 TINYTEX_DIR 即可，deploy/lib.sh 会把它的
# bin 目录加进 PATH，供 quarto 找到 xelatex。
TINYTEX_DIR="${TINYTEX_DIR:-$HOME/.TinyTeX}"

# ---- 界面文案 ----
APP_TITLE="${APP_TITLE:=财务数据分析平台}"
MENU_TEXT="${MENU_TEXT:=两个服务将同时启动。请选择要打开的页面:}"
