#!/usr/bin/env bash
# ============================================================
# local.env.example — 本机覆盖模板
# ============================================================
# 复制为 deploy/local.env 后按需修改（local.env 已被 .gitignore 忽略）。
# 本文件优先级最高，覆盖 defaults.env 与 profiles/<主题>.env。
# 适合放：临时端口、临时目录、内网 IP、以及不适合入库的值。

# 打印给用户访问的地址（服务器建议填内网 IP 或域名）
# PUBLIC_HOST="192.168.1.100"

# 端口被占用时临时改
# VIZRO_PORT=5002

# 该机未部署 SionTiles 地图服务
# ENABLE_SIONTILES=false

# 指向另一份 SionTiles 副本
# SIONTILES_DIR="/srv/SionTiles/web"
